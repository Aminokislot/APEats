# Copy to .env. Never commit real keys or credentials.
PORT=8080

# offline | gemini | enterprise. Developer API does not meet the Enterprise requirement.
AI_PROVIDER=offline
GEMINI_API_KEY=
# Choose a model enabled for your Developer API project if AI_PROVIDER=gemini.
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# Gemini Enterprise app and Workflow Builder chat agent. Requires Google ADC credentials.
GOOGLE_CLOUD_PROJECT=
ENTERPRISE_APP_ID=
ENTERPRISE_AGENT_ID=
ENTERPRISE_LOCATION=global

# Cloud Run requires firestore and an existing database.
VOTE_STORAGE=local
FIRESTORE_DATABASE=(default)
# VOTES_FILE=C:/path/to/private/votes.json

TRUST_PROXY=false

# Optional demo clock. Remove for actual Asia/Kuala_Lumpur time.
# DEMO_CLOCK=12:15
# DEMO_WEEKDAY=4
